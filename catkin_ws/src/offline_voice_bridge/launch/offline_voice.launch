<launch>
  <arg name="config" default="$(find offline_voice_bridge)/config/offline_voice.yaml" />
  <arg name="start_asr" default="true" />
  <arg name="start_tts" default="true" />
  <arg name="start_sound_play" default="true" />
  <!-- TB16p's analog speaker works through this ALSA device; the container's
       generic "default" PCM cannot open it. Override at launch if hardware changes. -->
  <arg name="sound_device" default="plughw:CARD=sofhdadsp,DEV=0" />

  <rosparam command="load" file="$(arg config)" subst_value="true" />

  <group if="$(arg start_sound_play)">
    <node name="soundplay_node" pkg="sound_play" type="soundplay_node.py" output="screen">
      <param name="device" value="$(arg sound_device)" />
    </node>
  </group>

  <group if="$(arg start_tts)">
    <node name="offline_tts_node" pkg="offline_voice_bridge" type="offline_tts_node.py" output="screen" />
  </group>

  <group if="$(arg start_asr)">
    <node name="offline_asr_node" pkg="offline_voice_bridge" type="offline_asr_node.py" output="screen" />
  </group>
</launch>
