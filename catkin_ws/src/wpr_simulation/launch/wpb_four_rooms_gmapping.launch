<launch>

  <!-- Four-room world for SLAM. Grab behavior nodes are disabled so they do not publish /cmd_vel during mapping. -->
  <include file="$(find wpr_simulation)/launch/wpb_four_rooms.launch">
    <arg name="start_grab_behaviors" value="false" />
  </include>

  <!-- Gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen" />

  <!-- RViz -->
  <arg name="rvizconfig" default="$(find wpr_simulation)/rviz/slam.rviz" />
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)" required="true" />

</launch>
