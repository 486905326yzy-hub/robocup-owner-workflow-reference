<launch>
  <arg name="image_topic" default="/kinect2/hd/image_color_rect" />
  <arg name="model_path" default="$(find yoloworld_perception)/models/yolov8s-world-person.pt" />
  <arg name="device" default="cuda:0" />
  <arg name="conf" default="0.30" />
  <arg name="imgsz" default="416" />
  <arg name="max_det" default="5" />
  <arg name="process_every_n" default="2" />
  <arg name="show_viewer" default="true" />

  <node pkg="yoloworld_perception" type="yoloworld_node.py" name="yoloworld" output="screen">
    <env name="PYTORCH_CUDA_ALLOC_CONF" value="expandable_segments:True" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="model_path" value="$(arg model_path)" />
    <param name="device" value="$(arg device)" />
    <param name="require_gpu" value="true" />
    <param name="imgsz" value="$(arg imgsz)" />
    <param name="conf" value="$(arg conf)" />
    <param name="iou" value="0.45" />
    <param name="max_det" value="$(arg max_det)" />
    <param name="process_every_n" value="$(arg process_every_n)" />
    <param name="classes" value="person" />
    <remap from="~detections" to="/perception/person_detections_2d" />
    <remap from="~debug_image" to="/perception/yoloworld/debug_image" />
  </node>

  <node if="$(arg show_viewer)" pkg="yoloworld_perception" type="yoloworld_debug_viewer.py" name="yoloworld_debug_viewer" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="debug_image_topic" value="/perception/yoloworld/debug_image" />
    <param name="show_raw" value="true" />
    <param name="show_debug" value="true" />
    <param name="raw_window" value="WPR Camera" />
    <param name="debug_window" value="YOLO-World Person Detection" />
  </node>
</launch>
